extends Node
const Store=preload("res://scripts/game/account_save_store.gd")
var checks:=0
var failed:=0
func check(ok:bool,msg:String):
	checks+=1
	if not ok:failed+=1;push_error(msg)
func _ready():call_deferred("run")
func control(route:String,data:Dictionary={}):return await CloudAccount._raw(route,HTTPClient.METHOD_POST,data,"")
func run():
	CloudAccount.set_process(false);CloudAccount.endpoint="http://127.0.0.1:8879";CloudAccount.public_key="sb_publishable_localtest"
	check(CloudAccount.valid_username("player_123") and not CloudAccount.valid_username("../escape"),"username syntax and path safety")
	check(not CloudAccount.valid_password("short") and not CloudAccount.valid_password("x".repeat(73)),"password length enforced")
	Game.slot=0;Game.new_character("Guest",Avatar.default_appearance())
	var guest_path:=Game.slot_path(0);var guest_hash:=FileAccess.get_sha256(guest_path)
	await CloudAccount.register_account("qa_one","test-only-password","mismatch")
	check(CloudAccount.user_id.is_empty(),"password confirmation mismatch does not create/sign in")
	await CloudAccount.register_account("qa_one","test-only-password","test-only-password")
	check(CloudAccount.hydrated and CloudAccount.username=="qa_one","game account registration hydrates account")
	var first_id:=CloudAccount.user_id
	check(Game.slot_count()==0 and FileAccess.get_sha256(guest_path)==guest_hash,"new account leaves guest saves intact")
	await CloudAccount.import_guest()
	check(Game.slot_count()==1 and CloudAccount.revision==1 and not CloudAccount.pending,"explicit guest copy reaches account database")
	check(Game.load_game(0) and Game.player_name=="Guest","copied character loads")
	Game.player_name="นักผจญภัย";Game.inventory={"potion_red":23};Game.zeny=4567;Game.save_point=Vector3(12,.1,-9)
	Game.save_game();await CloudAccount.sync()
	check(not CloudAccount.pending and CloudAccount.revision==2,"character progress uploads")
	var second=await CloudAccount._raw("/rest/v1/rpc/game_sign_in",HTTPClient.METHOD_POST,{"p_username":"qa_one","p_password":"test-only-password"},"")
	check(second.data.ok and second.data.user.id==first_id,"second device signs into same stable account")
	var second_token:String=second.data.session_token
	var cloud=await CloudAccount._raw("/rest/v1/rpc/game_read_save",HTTPClient.METHOD_POST,{"p_session_token":second_token},"")
	check(Store.install("device_two",cloud.data.payload),"second device installs account bundle")
	CloudAccount.user_id="device_two"
	check(Game.load_game(0) and Game.player_name=="นักผจญภัย" and Game.inventory.potion_red==23 and Game.zeny==4567 and Game.save_point.is_equal_approx(Vector3(12,.1,-9)),"second device restores name, money, inventory and position")
	CloudAccount.user_id=first_id
	await control("/test/offline",{"fail":true})
	Game.zeny=9999;Game.save_game();await CloudAccount.sync()
	check(CloudAccount.pending and Game.load_game(0) and Game.zeny==9999,"offline saves remain durable")
	await control("/test/offline",{"fail":false});await CloudAccount.sync()
	check(not CloudAccount.pending,"offline retry reaches database")
	cloud=await CloudAccount._raw("/rest/v1/rpc/game_read_save",HTTPClient.METHOD_POST,{"p_session_token":second_token},"")
	cloud.data.payload.slots[0].zeny=8888
	var write=await CloudAccount._raw("/rest/v1/rpc/game_write_save",HTTPClient.METHOD_POST,{"p_session_token":second_token,"p_expected_revision":cloud.data.revision,"p_payload":cloud.data.payload},"")
	check(write.data.ok,"second device advances save")
	Game.zeny=1111;Game.save_game();await CloudAccount.sync()
	check(CloudAccount.conflict and CloudAccount.pending and not CloudAccount.can_play(),"stale first device cannot overwrite another device")
	await CloudAccount.resolve_conflict(false)
	check(not CloudAccount.conflict and Game.load_game(0) and Game.zeny==8888,"cloud conflict choice restores newer save")
	check(not DirAccess.get_directories_at(CloudAccount.storage_prefix()+"backups").is_empty(),"conflict keeps backup")
	await control("/test/advance",{"username":"qa_one"})
	Game.zeny=2222;Game.save_game();await CloudAccount.sync();await CloudAccount.resolve_conflict(true)
	check(not CloudAccount.conflict and not CloudAccount.pending,"explicit local choice resolves conflict")
	var malformed:=Store.capture(first_id);malformed.slots[0].save_point=["bad",0,0]
	var before:=FileAccess.get_sha256(Game.slot_path(0))
	check(not Store.install(first_id,malformed) and FileAccess.get_sha256(Game.slot_path(0))==before,"invalid download does not change local character")
	await control("/test/delay");Game.zeny=4444;Game.save_game();CloudAccount.sync()
	await get_tree().create_timer(.05).timeout;Game.zeny=5555;Game.save_game()
	while CloudAccount.busy:await get_tree().process_frame
	check(CloudAccount.pending,"in-flight save changes remain pending")
	await CloudAccount.sync();check((await CloudAccount._fetch_remote()).payload.slots[0].zeny==5555,"follow-up sync includes newest save")
	Game.delete_slot(0);await CloudAccount.sync()
	check((await CloudAccount._fetch_remote()).payload.slots[0]==null,"slot deletion syncs")
	await CloudAccount.sign_out()
	check(CloudAccount.user_id.is_empty() and CloudAccount._token.is_empty() and FileAccess.get_sha256(guest_path)==guest_hash,"logout restores original guest save")
	await CloudAccount.sign_in("qa_one","wrong-password")
	check(CloudAccount.user_id.is_empty(),"wrong password denied")
	await CloudAccount.register_account("QA_ONE","different-password","different-password")
	check(CloudAccount.user_id.is_empty(),"duplicate username denied")
	await CloudAccount.register_account("qa_two","second-test-password","second-test-password")
	check(CloudAccount.user_id!=first_id and Game.slot_count()==0,"another account has isolated empty slots")
	Game.new_character("Only account two",Avatar.default_appearance());Game.zeny=987;Game.save_game();await CloudAccount.sync()
	var a_save=await CloudAccount._raw("/rest/v1/rpc/game_read_save",HTTPClient.METHOD_POST,{"p_session_token":second_token},"")
	check(a_save.data.payload.slots[0]==null,"other-account writes do not affect first account")
	await CloudAccount.sign_out()
	check(not await CloudAccount.accept_game_session({"session_token":"0".repeat(64),"expected_username":"qa_one"}),"web handoff requires valid server session")
	check(not await CloudAccount.accept_game_session({"session_token":second_token,"expected_username":"qa_two"}),"web handoff must match expected account")
	check(await CloudAccount.accept_game_session({"session_token":second_token,"expected_username":"qa_one"}) and CloudAccount.hydrated,"web portal handoff signs in and hydrates")
	await CloudAccount.sign_out()
	var panel=preload("res://scripts/ui/account_panel.gd").new();add_child(panel)
	check(panel.get_child_count()>4,"username/password account UI renders");panel.free()
	print("GAME ACCOUNT CLIENT CHECKS: ",checks," FAILED: ",failed)
	get_tree().quit(1 if failed else 0)
