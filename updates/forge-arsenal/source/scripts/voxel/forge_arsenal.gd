static func has(id: String) -> bool:
	return SPRITES.has(id)


static func model(id: String) -> MeshInstance3D:
	var spec: Dictionary = SPRITES[id]
	var mesh := MeshInstance3D.new()
	mesh.name = id
	mesh.mesh = VoxelSprite.extrude(spec.rows, spec.palette, spec.pitch, spec.grip)
	mesh.material_override = VoxelSprite.material()
	return mesh


static func icon(id: String) -> Texture2D:
	var spec: Dictionary = SPRITES[id]
	var rows: Array = spec.rows
	var palette: Dictionary = spec.palette
	var size: int = rows.size()
	var image := Image.create(size, size, false, Image.FORMAT_RGBA8)
	for y in rows.size():
		var row: String = rows[y]
		var x_offset := (size - row.length()) / 2
		for x in row.length():
			if row[x] != ".":
				image.set_pixel(x + x_offset, y, palette[row[x]])
	return ImageTexture.create_from_image(image)
